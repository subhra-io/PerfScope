# PerfScope Dashboard Environment Variables

# Backend API URL (replace with your deployed backend URL)
NEXT_PUBLIC_API_URL=https://your-backend-api.com

# WebSocket URL for real-time updates (replace with your deployed backend WS URL)
NEXT_PUBLIC_WS_URL=wss://your-backend-api.com

# Optional: Analytics and monitoring
# NEXT_PUBLIC_ANALYTICS_ID=your-analytics-id